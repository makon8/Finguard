{
  "datasets": [
    {
      "name": "customers",
      "displayName": "Customer Data",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  first_name,\n",
        "  last_name,\n",
        "  customer_segment,\n",
        "  risk_score,\n",
        "  trusted_device_id,\n",
        "  city,\n",
        "  country\n",
        "FROM\n",
        "  customers\n",
        "ORDER BY\n",
        "  risk_score DESC"
      ],
      "catalog": "finguard2",
      "schema": "bronze"
    },
    {
      "name": "high_value_alert",
      "displayName": "High Value Transaction Alerts",
      "queryLines": [
        "SELECT\n",
        "  alert_id,\n",
        "  alert_timestamp,\n",
        "  transaction_id,\n",
        "  customer_id,\n",
        "  customer_name,\n",
        "  transaction_amount,\n",
        "  transaction_limit,\n",
        "  currency,\n",
        "  merchant_name,\n",
        "  merchant_category\n",
        "FROM\n",
        "  high_value_transactions_alert\n",
        "ORDER BY\n",
        "  alert_timestamp DESC"
      ],
      "catalog": "finguard2",
      "schema": "gold"
    },
    {
      "name": "fraud_card_alert",
      "displayName": "Fraud Card Alerts",
      "queryLines": [
        "SELECT\n",
        "  alert_id,\n",
        "  alert_timestamp,\n",
        "  transaction_id,\n",
        "  customer_id,\n",
        "  customer_name,\n",
        "  card_number,\n",
        "  amount,\n",
        "  currency,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  transaction_city,\n",
        "  transaction_country,\n",
        "  watchlist_id,\n",
        "  watch_type,\n",
        "  risk_level,\n",
        "  device_id\n",
        "FROM\n",
        "  fraud_card_alert\n",
        "ORDER BY\n",
        "  alert_timestamp DESC"
      ],
      "catalog": "finguard2",
      "schema": "gold"
    },
    {
      "name": "transaction_count_by_minute",
      "displayName": "Transaction Count by Minute",
      "queryLines": [
        "SELECT\n",
        "  window_start,\n",
        "  window_end,\n",
        "  transaction_count\n",
        "FROM\n",
        "  transaction_count_by_minute\n",
        "ORDER BY\n",
        "  window_start DESC"
      ],
      "catalog": "finguard2",
      "schema": "gold"
    },
    {
      "name": "silver_transactions",
      "displayName": "All Transactions",
      "queryLines": [
        "SELECT\n",
        "  transaction_id,\n",
        "  customer_id,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  amount,\n",
        "  currency,\n",
        "  transaction_type,\n",
        "  payment_channel,\n",
        "  city,\n",
        "  country,\n",
        "  is_international,\n",
        "  transaction_timestamp,\n",
        "  status\n",
        "FROM\n",
        "  transactions\n",
        "ORDER BY\n",
        "  transaction_timestamp DESC"
      ],
      "catalog": "finguard2",
      "schema": "silver"
    },
    {
      "name": "device_mismatch",
      "displayName": "Device Mismatch Alerts",
      "queryLines": [
        "SELECT\n",
        "  a.alert_id,\n",
        "  a.customer_id,\n",
        "  a.device_id as alert_device_id,\n",
        "  c.trusted_device_id,\n",
        "  CASE\n",
        "    WHEN a.device_id != c.trusted_device_id THEN 'Mismatch'\n",
        "    ELSE 'Match'\n",
        "  END as device_status\n",
        "FROM\n",
        "  fraud_card_alert a\n",
        "    LEFT JOIN finguard2.bronze.customers c\n",
        "      ON a.customer_id = c.customer_id\n",
        "WHERE\n",
        "  a.device_id IS NOT NULL"
      ],
      "catalog": "finguard2",
      "schema": "gold"
    },
    {
      "name": "high_risk_customers",
      "displayName": "High Risk Customers with Alerts",
      "queryLines": [
        "SELECT\n",
        "  c.customer_id,\n",
        "  c.first_name,\n",
        "  c.last_name,\n",
        "  c.risk_score,\n",
        "  c.customer_segment,\n",
        "  COUNT(a.alert_id) as alert_count\n",
        "FROM\n",
        "  finguard2.bronze.customers c\n",
        "    LEFT JOIN finguard2.gold.fraud_card_alert a\n",
        "      ON c.customer_id = a.customer_id\n",
        "WHERE\n",
        "  c.risk_score > 70\n",
        "GROUP BY\n",
        "  c.customer_id,\n",
        "  c.first_name,\n",
        "  c.last_name,\n",
        "  c.risk_score,\n",
        "  c.customer_segment\n",
        "ORDER BY\n",
        "  c.risk_score DESC,\n",
        "  alert_count DESC"
      ],
      "catalog": "finguard2",
      "schema": "bronze"
    }
  ],
